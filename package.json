{
  "name": "kp-large-list",
  "version": "0.1.0",
  "description": "Generic, high-performance list and grid for React Native, built on FlashList v2, with cached images and skeleton states.",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karanparihar177/KPLargeList.git"
  },
  "main": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests",
    "test": "jest",
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "example:start": "yarn --cwd example start",
    "example:ios": "yarn --cwd example ios",
    "example:android": "yarn --cwd example android",
    "prepack": "yarn build"
  },
  "peerDependencies": {
    "@shopify/flash-list": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "react-native-fast-image": ">=10.8.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@react-native/typescript-config": "0.88.0",
    "@shopify/flash-list": "^2.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-fast-image": "10.8.5",
    "react-test-renderer": "19.3.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.18.1",
  "keywords": [
    "react-native",
    "flash-list",
    "list",
    "grid",
    "virtualized",
    "skeleton",
    "image",
    "ios",
    "android"
  ]
}
